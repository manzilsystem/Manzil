{
  "name": "manzil-app",
  "private": true,
  "description": "Manzil property management PWA",
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:index": "npm run build:css && npm run build:vendor && node scripts/build-index.mjs",
    "check:index": "node scripts/build-css.mjs --check && node scripts/build-vendor.mjs --check && node scripts/build-index.mjs --check",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/postcss": "^4.3.5",
    "autoprefixer": "^10.7.0",
    "chart.js": "^4.4.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "xlsx": "^0.18.5"
  }
}
