# انسخ هذا الملف إلى `.env` في جذر المشروع (نفس مستوى مجلد supabase/) واملأ القيم محليًا.
# `.env` مستبعد في .gitignore؛ لا ترفع أي قيمة حقيقية إلى المستودع أو السجلات.

# مخصّص لتسجيل دخول Supabase CLI عند نشر Edge Functions.
# يجب أن يبدأ بـ sbp_ (من https://supabase.com/dashboard/account/tokens).
# لا تضع هنا مفتاح sb_secret_... ولا service_role؛ تلك مفاتيح API للمشروع وليست رموز دخول CLI.
SUPABASE_ACCESS_TOKEN=

# مطلوب فقط عند ربط CLI بالمشروع المستضاف عبر `supabase link`.
SUPABASE_DB_PASSWORD=

# صياغة عم عبده باللهجة المصرية عبر Groq.
# محليًا: يقرأها scripts/groq-dev-server.mjs فقط، ولا تُرسل للمتصفح.
# في النشر: تُضبط كأسرار في Supabase (`supabase secrets set`) ويستخدمها
# Edge Function اسمه assistant-groq. اتركها فارغة ليبقى المساعد حتميًا بلا صياغة.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# قراءة ردود عم عبده بصوت عربي رجالي من Groq. الصوت الافتراضي abdullah.
# canopylabs/orpheus-arabic-saudi يحتاج قبول شروط النموذج من أدمن مؤسسة Groq؛
# قبل القبول يبقى البديل هو صوت المتصفح. الحد الأقصى 200 حرف لكل مقطع.
GROQ_TTS_MODEL=canopylabs/orpheus-arabic-saudi
GROQ_TTS_VOICE=abdullah
