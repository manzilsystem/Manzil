# Cache policy for hosts that read _headers (Netlify, Cloudflare Pages).
#
# GitHub Pages ignores this file and cannot send custom Cache-Control headers,
# which is why the Service Worker (sw.js) is the real cache layer in production.
# Keep this file in sync with the policy documented in docs/auto-update.md.

# Content-hashed assets: the "?v=<hash>" token changes whenever the file
# changes, so every URL is immutable and can be cached for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell and the worker must revalidate so a new release becomes
# visible on the next open without a manual cache clear.
/
  Cache-Control: public, max-age=3600, must-revalidate
/index.html
  Cache-Control: public, max-age=3600, must-revalidate
/sw.js
  Cache-Control: no-cache
